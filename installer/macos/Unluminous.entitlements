<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements both programs in Unluminous.app are signed with, `unluminous` and `unluminous-cli`.

  disable-library-validation: the code index embeds text with ONNX Runtime, which `ort` loads at run time
  from the copy `inillucent setup-embeddings` installed under ~/Library/Application Support/inillucent.
  That library is not signed by this team, and the hardened runtime refuses to map a library signed by
  another team, or by none: `dlopen` answers "mapping process and mapped file (non-platform) have
  different Team IDs", and `ort` panics with "`OrtGetApiBase` must be present in ONNX Runtime dylib".
  Without this entitlement no Developer ID build of Unluminous could ever embed anything.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
