eventmodeling
title Shopping cart

tf 01 ui CartUI
tf 02 cmd AddItem [[AddItem01]]
tf 03 evt ItemAdded [[ItemAdded]]
tf 04 rmo CartItems { items: list } ->> 03
tf 05 ui CartUI
rf 06 evt External.InventoryChanged `json`{ "sku": "a-1", "stock": 3 }
tf 07 pcr InventoryProcessor
tf 08 cmd ChangeInventory
tf 09 evt Cart.InventoryChanged
rf 10 rmo StockView ->> 06 ->> 09

data AddItem01 {
  description: 'john'
  image: 'avatar_john'
  price: 20.4
}

data ItemAdded {
  description: string
  image: string
  price: number
}
